# Public client-side variables
NEXT_PUBLIC_SITE_URL=https://kuarkcoin.com # Public canonical site URL
NEXT_PUBLIC_SUPABASE_URL= # Public Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY= # Public Supabase anon key

# Server-only Supabase
SUPABASE_URL= # Server-side Supabase URL; can match NEXT_PUBLIC_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY= # Server-only service role key; never expose to client

# Server-only security secrets
SCAN_SECRET= # TradingView webhook shared secret
ADMIN_API_SECRET= # Bearer secret for protected signal mutation endpoints
CRON_SECRET= # Bearer secret used by Vercel Cron

# Server-only AI
GEMINI_API_KEY= # Google Gemini API key
GEMINI_MODEL=gemini-2.5-flash # Optional model override

# Server-only market data
FINNHUB_API_KEY= # Finnhub market/news/candle API key

# Server-only Upstash Redis REST (rate limit + cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
