# Kuarkcoin environment variables
# Copy this file to `.env.local` for local development or configure the same keys in Vercel.
#
# IMPORTANT: Do not add the NEXT_PUBLIC_ prefix to server-only secrets.
# NEXT_PUBLIC_* values are bundled into browser/client-side code and must be safe to expose.

# -----------------------------------------------------------------------------
# Public application URLs
# -----------------------------------------------------------------------------
# Canonical public origin of the app. Used when the server needs to build absolute URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Legacy compatibility alias. Existing code should prefer NEXT_PUBLIC_APP_URL, but this
# can be kept equal to NEXT_PUBLIC_APP_URL while older deployments migrate.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Server-only Supabase project URL used by API routes/server helpers.
SUPABASE_URL="https://your-project-ref.supabase.co"

# Server-only service role key. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Browser-safe Supabase URL for client-side Supabase usage.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Browser-safe anon key for client-side Supabase usage. Do not use the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Legacy note: DATABASE_URL is not used by the current Supabase JS client in this app.
# Keep it only if a separate migration/CLI workflow in your environment still needs it.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# -----------------------------------------------------------------------------
# Internal API / cron secrets
# -----------------------------------------------------------------------------
# Shared secret required by signal scan endpoints. Server-only; no NEXT_PUBLIC_ prefix.
SCAN_SECRET="replace-with-a-long-random-secret"

# Shared secret used by Vercel cron requests (see vercel.json). Server-only.
CRON_SECRET="replace-with-a-long-random-secret"

# Admin-only secret for protected signal/admin actions. Server-only.
SIGNALS_ADMIN_SECRET="replace-with-a-long-random-secret"

# Comma-separated list of admin email addresses allowed to access admin flows.
ADMIN_EMAILS="admin@example.com,ops@example.com"

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
# Gemini API key. Some routes also accept GOOGLE_API_KEY as a fallback alias.
GEMINI_API_KEY="your-gemini-api-key"
# GOOGLE_API_KEY="your-google-api-key"

# Gemini model used by AI analysis routes when they allow configuration.
GEMINI_MODEL="gemini-2.5-flash"

# -----------------------------------------------------------------------------
# Market data
# -----------------------------------------------------------------------------
# Finnhub token used by news and top-margin cron/API routes. Server-only.
FINNHUB_API_KEY="your-finnhub-api-key"

# -----------------------------------------------------------------------------
# Vercel KV / Upstash Redis
# -----------------------------------------------------------------------------
# Required by @vercel/kv for cached top-margin data. Values are provided by the
# Vercel KV / Upstash Redis integration in production.
KV_URL="redis://default:password@host:6379"
KV_REST_API_URL="https://your-kv-instance.upstash.io"
KV_REST_API_TOKEN="your-kv-rest-token"
KV_REST_API_READ_ONLY_TOKEN="your-kv-rest-read-only-token"

# Upstash Redis aliases that may be present in newer Vercel Redis integrations.
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# Current default provider. Keep as manual unless Stripe checkout/webhooks are enabled.
PAYMENT_PROVIDER="manual"

# Stripe placeholders for future/optional Stripe integration. Server-only except publishable key.
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"
STRIPE_PRICE_ID="price_your-stripe-price-id"

# -----------------------------------------------------------------------------
# Email (optional)
# -----------------------------------------------------------------------------
# Optional Resend API key for transactional email. Server-only.
RESEND_API_KEY="re_your-resend-api-key"

# Sender address used for outgoing emails when email delivery is enabled.
EMAIL_FROM="Kuarkcoin <noreply@example.com>"
